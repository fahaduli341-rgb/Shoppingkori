rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'fahad1e1e1@gmail.com' ||
        request.auth.token.email == 'fahad1wo8@gmail.com' ||
        request.auth.token.email == 'admin@shoppingkori.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Products catalog - live catalog management (read, create, update, delete)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders placed by customers and managed by store administrators
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Marketplace Vendors (read, register, update, delete)
    match /vendors/{vendorId} {
      allow read, write: if true;
    }

    // Discount Coupons & Promo Vouchers (read, add, update, delete)
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Admins document
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Store settings (hotline, WhatsApp, delivery charges, admin password, announcements)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Connection check document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
